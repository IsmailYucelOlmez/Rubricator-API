# FastAPI semantic discovery service
# development = API_KEY optional (local/no-auth); production = API_KEY required at startup
ENVIRONMENT=development
GOOGLE_API_KEY=
GOOGLE_BOOKS_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
CLUSTER_ENDPOINT=
CLUSTER_API_KEY=
QDRANT_COLLECTION=book_catalog
CATALOG_BACKEND=supabase
SEMANTIC_QUERY_CACHE_TTL_SECONDS=3600
MAX_NEW_BOOKS=5
CORS_ORIGINS=*
API_KEY=
# Apply user relevance votes to search ranking (vote collection works regardless)
FEEDBACK_RERANK_ENABLED=false
